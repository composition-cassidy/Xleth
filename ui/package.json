{
  "name": "xleth-ui",
  "version": "1.1.0-beta",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "brand:engine-host": "node scripts/brand-engine-host.cjs",
    "predev": "node scripts/brand-engine-host.cjs",
    "prestart": "node scripts/brand-engine-host.cjs",
    "dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:clip-controls": "set VITE_XLETH_CLIP_CONTROL_TUNER=1&& concurrently --kill-others \"vite --force\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:ui-kit": "set VITE_XLETH_UI_KIT_GALLERY=1&& concurrently --kill-others \"vite --force\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "node scripts/brand-engine-host.cjs --strict && npm run build && electron-builder --config electron-builder.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/ui-kit/**/*.css\" \"src/**/*.module.css\"",
    "check:legacy-css": "node scripts/check-legacy-css.mjs",
    "shots": "node tests/ui-render/shots.mjs",
    "shots:gallery": "node tests/ui-render/shots.mjs --gallery",
    "test:watch": "vitest",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "baseline:build": "vite build",
    "baseline:capture": "playwright test --update-snapshots --config playwright.config.ts",
    "baseline:check": "playwright test --config playwright.config.ts",
    "baseline": "npm run baseline:build && npm run baseline:capture && npm run baseline:check",
    "baseline:clip-controls:capture": "playwright test --update-snapshots --config playwright.clip-controls.config.ts",
    "baseline:clip-controls:check": "playwright test --config playwright.clip-controls.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans": "^5.2.10",
    "@xyflow/react": "^12.10.2",
    "archiver": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "~1.59.1",
    "pngjs": "^7.0.0",
    "stylelint": "^18.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wait-on": "^8.0.0"
  }
}
