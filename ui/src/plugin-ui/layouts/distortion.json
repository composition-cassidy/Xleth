{
  "$xleth": "plugin-ui-layout",
  "schemaVersion": 1,
  "pluginId": "distortion",
  "name": "Default Distortion Layout",
  "panel": {
    "preferredSize": { "width": 380, "height": 300 }
  },
  "root": {
    "id": "distortion-root",
    "type": "panel",
    "children": [
      {
        "id": "mode-grid",
        "type": "column",
        "style": { "paddingPx": [8, 10, 4, 10], "gapPx": 4 },
        "children": [
          {
            "id": "mode-row-saturation",
            "type": "row",
            "style": { "gapPx": 4, "justify": "center" },
            "children": [
              { "id": "mode-tube",      "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 0, "label": "Tube" } },
              { "id": "mode-soft-clip", "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 1, "label": "Soft Clip" } },
              { "id": "mode-sine",      "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 6, "label": "Sine" } },
              { "id": "mode-analog",    "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 3, "label": "Analog" } }
            ]
          },
          {
            "id": "mode-row-clip-digital",
            "type": "row",
            "style": { "gapPx": 4, "justify": "center" },
            "children": [
              { "id": "mode-hard-clip",  "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 2, "label": "Hard Clip" } },
              { "id": "mode-fuzz",       "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 5, "label": "Fuzz" } },
              { "id": "mode-clip-digital-divider", "type": "spacer", "style": { "widthPx": 1 } },
              { "id": "mode-crush",      "type": "toggle", "style": { "growsToFill": true }, "props": { "param": "mode", "mode": "discreteValue", "valueWhenOn": 4, "label": "Crush" } },
              { "id": "mode-reserved",   "type": "button", "style": { "growsToFill": true }, "props": { "action": "distortion.reserved", "label": "—" } }
            ]
          }
        ]
      },
      {
        "id": "curve-panel",
        "type": "panel",
        "style": { "paddingPx": [4, 10, 4, 10] },
        "children": [
          { "id": "distortion-curve", "type": "distortionCurve", "style": { "heightPx": 190 } }
        ]
      },
      {
        "id": "knob-row",
        "type": "row",
        "style": { "paddingPx": [8, 12, 8, 12], "gapPx": 12, "justify": "center" },
        "children": [
          { "id": "drive-knob",      "type": "knob", "props": { "param": "drive",      "label": "DRIVE",      "size": 64, "format": "dB1",  "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "tone-knob",       "type": "knob", "props": { "param": "tone",       "label": "TONE",       "size": 52, "format": "hz0",  "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "mix-knob",        "type": "knob", "props": { "param": "mix",        "label": "MIX",        "size": 52, "format": "pct0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "symmetry-knob",   "type": "knob", "props": { "param": "symmetry",   "label": "SYMMETRY",   "size": 44, "format": "pct0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" }, "enabledWhen": { "param": "mode", "in": [3] } } },
          { "id": "bits-knob",       "type": "knob", "props": { "param": "bits",       "label": "BITS",       "size": 40, "format": "raw",  "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" }, "enabledWhen": { "param": "mode", "in": [4] } } },
          { "id": "downsample-knob", "type": "knob", "props": { "param": "downsample", "label": "DOWNSAMPLE", "size": 40, "format": "x0",   "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" }, "enabledWhen": { "param": "mode", "in": [4] } } }
        ]
      },
      {
        "id": "filter-row",
        "type": "row",
        "style": { "paddingPx": [4, 10, 10, 10], "gapPx": 6, "align": "center" },
        "children": [
          { "id": "filter-label", "type": "label", "props": { "text": "Filter:", "variant": "muted" } },
          { "id": "filter-pre",  "type": "toggle", "props": { "param": "filter_pos", "mode": "discreteValue", "valueWhenOn": 0, "label": "Pre" } },
          { "id": "filter-post", "type": "toggle", "props": { "param": "filter_pos", "mode": "discreteValue", "valueWhenOn": 1, "label": "Post" } },
          { "id": "filter-peak-spacer", "type": "spacer" },
          {
            "id": "peak-bars",
            "type": "row",
            "style": { "widthPx": 120, "gapPx": 8, "align": "center" },
            "children": [
              { "id": "peak-l", "type": "meter", "style": { "growsToFill": true }, "props": { "source": { "kind": "effectMeter", "slot": "PEAK_L" }, "orientation": "horizontal", "range": { "min": 0, "max": 1 }, "format": "raw", "label": "L" } },
              { "id": "peak-r", "type": "meter", "style": { "growsToFill": true }, "props": { "source": { "kind": "effectMeter", "slot": "PEAK_R" }, "orientation": "horizontal", "range": { "min": 0, "max": 1 }, "format": "raw", "label": "R" } }
            ]
          }
        ]
      }
    ]
  }
}
