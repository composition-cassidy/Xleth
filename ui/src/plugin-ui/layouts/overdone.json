{
  "$xleth": "plugin-ui-layout",
  "schemaVersion": 1,
  "pluginId": "overdone",
  "name": "Default Overdone Layout",
  "panel": {
    "preferredSize": { "width": 540, "height": 482 }
  },
  "root": {
    "id": "root",
    "type": "panel",
    "style": { "gapPx": 0 },
    "children": [
      {
        "id": "top-row",
        "type": "row",
        "style": { "paddingPx": [14, 12, 6, 12], "gapPx": 20, "align": "start", "justify": "center" },
        "children": [
          { "id": "k-depth",  "type": "knob", "props": { "param": "depth",      "label": "DEPTH",  "size": 56, "format": "pct0",       "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-time",   "type": "knob", "props": { "param": "time",       "label": "TIME",   "size": 56, "format": "pct0",       "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-input",  "type": "knob", "props": { "param": "inputGain",  "label": "INPUT",  "size": 56, "format": "dB1_signed", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-output", "type": "knob", "props": { "param": "outputGain", "label": "OUTPUT", "size": 56, "format": "dB1_signed", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } }
        ]
      },
      {
        "id": "bands-row",
        "type": "row",
        "style": { "paddingPx": [6, 12, 6, 12] },
        "children": [
          {
            "id": "band-stack",
            "type": "overdoneBandStack",
            "style": { "growsToFill": true },
            "props": { "heightPx": 168 }
          }
        ]
      },
      {
        "id": "xover-row",
        "type": "row",
        "style": { "paddingPx": [6, 12, 12, 12] },
        "children": [
          {
            "id": "xover-display",
            "type": "overdoneCrossovers",
            "style": { "growsToFill": true },
            "props": { "heightPx": 132 }
          }
        ]
      }
    ]
  }
}
