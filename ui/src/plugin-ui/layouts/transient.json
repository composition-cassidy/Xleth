{
  "$xleth": "plugin-ui-layout",
  "schemaVersion": 1,
  "pluginId": "transientproc",
  "name": "Default Transient Processor Layout",
  "panel": {
    "preferredSize": { "width": 540, "height": 460 }
  },
  "root": {
    "id": "root",
    "type": "panel",
    "style": { "gapPx": 0 },
    "children": [
      {
        "id": "viz-row",
        "type": "row",
        "style": { "paddingPx": [12, 12, 8, 12] },
        "children": [
          {
            "id": "transient-viz",
            "type": "visualizer",
            "style": { "growsToFill": true },
            "props": {
              "source": "transient.shaper",
              "preset": "transientShaper",
              "heightPx": 292
            }
          }
        ]
      },
      {
        "id": "body",
        "type": "row",
        "style": { "paddingPx": [4, 16, 16, 16], "gapPx": 28, "align": "start", "justify": "center" },
        "children": [
          { "id": "k-attack",    "type": "knob", "props": { "param": "attack",       "label": "ATTACK",    "size": 56, "format": "pct0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-sustain",   "type": "knob", "props": { "param": "sustain",      "label": "SUSTAIN",   "size": 56, "format": "pct0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-speed",     "type": "knob", "props": { "param": "attack_speed", "label": "SPEED",     "size": 56, "format": "ms1",  "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-threshold", "type": "knob", "props": { "param": "threshold",    "label": "THRESHOLD", "size": 56, "format": "dB1",  "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
          { "id": "k-mix",       "type": "knob", "props": { "param": "mix",          "label": "MIX",       "size": 56, "format": "pct0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } }
        ]
      }
    ]
  }
}
