{
  "$xleth": "plugin-ui-layout",
  "schemaVersion": 1,
  "pluginId": "compressor",
  "name": "Curve Compressor Layout",
  "panel": {
    "preferredSize": { "width": 540, "height": 470 }
  },
  "root": {
    "id": "root",
    "type": "panel",
    "style": { "gapPx": 0 },
    "children": [
      {
        "id": "viz-row",
        "type": "row",
        "style": { "paddingPx": [10, 10, 10, 10] },
        "children": [
          {
            "id": "compressor-curve",
            "type": "compressorCurve",
            "style": { "growsToFill": true, "heightPx": 286 },
            "props": {
              "thresholdParam": "threshold",
              "ratioParam": "ratio",
              "kneeParam": "knee"
            }
          }
        ]
      },
      {
        "id": "body",
        "type": "row",
        "style": { "paddingPx": [4, 14, 14, 14], "gapPx": 14, "align": "start" },
        "children": [
          {
            "id": "shape-col",
            "type": "column",
            "style": { "gapPx": 14, "align": "center" },
            "children": [
              {
                "id": "shape-knobs",
                "type": "row",
                "style": { "gapPx": 12, "align": "start" },
                "children": [
                  { "id": "k-threshold", "type": "knob", "props": { "param": "threshold", "label": "THRESHOLD", "size": 56, "format": "dB1",   "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
                  { "id": "k-ratio",     "type": "knob", "props": { "param": "ratio",     "label": "RATIO",     "size": 56, "format": "ratio", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
                  { "id": "k-knee",      "type": "knob", "props": { "param": "knee",      "label": "KNEE",      "size": 56, "format": "dB1",   "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } }
                ]
              },
              {
                "id": "detect-row",
                "type": "row",
                "props": { "variant": "segmented" },
                "children": [
                  { "id": "btn-peak", "type": "toggle", "props": { "param": "detect_mode", "mode": "discreteValue", "valueWhenOn": 0, "label": "Peak" } },
                  { "id": "btn-rms",  "type": "toggle", "props": { "param": "detect_mode", "mode": "discreteValue", "valueWhenOn": 1, "label": "RMS" } }
                ]
              }
            ]
          },
          { "id": "body-divider", "type": "spacer", "style": { "widthPx": 1, "heightPx": 138 } },
          {
            "id": "time-col",
            "type": "column",
            "style": { "gapPx": 8, "align": "center" },
            "children": [
              { "id": "k-attack",  "type": "knob", "props": { "param": "attack",  "label": "ATTACK",  "size": 50, "format": "ms1", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
              { "id": "k-release", "type": "knob", "props": { "param": "release", "label": "RELEASE", "size": 50, "format": "ms0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } }
            ]
          },
          {
            "id": "level-rails",
            "type": "row",
            "style": { "gapPx": 16, "align": "start", "growsToFill": true, "justify": "end" },
            "children": [
              { "id": "s-mix",       "type": "compressorSlider", "props": { "param": "mix",       "label": "MIX",       "format": "pct0", "variant": "rail" } },
              { "id": "s-gain",      "type": "compressorSlider", "props": { "param": "makeup",    "label": "GAIN",      "format": "dB1",  "variant": "rail" } },
              { "id": "s-lookahead", "type": "compressorSlider", "props": { "param": "lookahead", "label": "LOOKAHEAD", "format": "ms1",  "variant": "rail" } }
            ]
          }
        ]
      }
    ]
  }
}
