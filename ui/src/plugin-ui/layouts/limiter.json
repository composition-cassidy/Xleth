{
  "$xleth": "plugin-ui-layout",
  "schemaVersion": 1,
  "pluginId": "limiter",
  "name": "Waveform Limiter Layout",
  "panel": {
    "preferredSize": { "width": 560, "height": 400 }
  },
  "root": {
    "id": "root",
    "type": "panel",
    "children": [
      {
        "id": "main-row",
        "type": "row",
        "style": { "paddingPx": [10, 12, 12, 12], "gapPx": 16, "align": "stretch" },
        "children": [
          {
            "id": "display-col",
            "type": "column",
            "style": { "growsToFill": true, "gapPx": 8 },
            "children": [
              {
                "id": "style-row-wrap",
                "type": "row",
                "style": { "justify": "center" },
                "children": [
                  {
                    "id": "style-row",
                    "type": "row",
                    "props": { "variant": "segmented" },
                    "children": [
                      {
                        "id": "btn-style-transparent",
                        "type": "toggle",
                        "props": { "param": "style", "mode": "discreteValue", "valueWhenOn": 0, "label": "Transparent" }
                      },
                      {
                        "id": "btn-style-punchy",
                        "type": "toggle",
                        "props": { "param": "style", "mode": "discreteValue", "valueWhenOn": 1, "label": "Punchy" }
                      },
                      {
                        "id": "btn-style-aggressive",
                        "type": "toggle",
                        "props": { "param": "style", "mode": "discreteValue", "valueWhenOn": 2, "label": "Aggressive" }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "limiter-viz",
                "type": "visualizer",
                "style": { "growsToFill": true },
                "props": {
                  "source": "limiter.realtime",
                  "preset": "limiterWaveform",
                  "heightPx": 300
                }
              }
            ]
          },
          {
            "id": "knob-col",
            "type": "column",
            "style": { "gapPx": 16, "align": "center", "justify": "center" },
            "children": [
              { "id": "k-gain",    "type": "knob", "props": { "param": "gain",    "label": "GAIN",    "size": 56, "format": "dB1", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
              { "id": "k-ceiling", "type": "knob", "props": { "param": "ceiling", "label": "CEILING", "size": 56, "format": "dB1", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } },
              { "id": "k-release", "type": "knob", "props": { "param": "release", "label": "RELEASE", "size": 56, "format": "ms0", "appearance": { "preset": "mixer-ring", "sizePreset": "inherit" } } }
            ]
          }
        ]
      }
    ]
  }
}
