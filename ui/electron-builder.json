{
  "appId": "com.xleth.app",
  "productName": "XLETH",
  "files": ["dist/**/*", "src/plugin-ui/layouts/*.json", "src/fx-presets/factory/**/*.json", "main.js", "electron-main/**/*", "preload.js", "rpc-manifest.js", "runtimePaths.js", "workspaceBackdropCapability.js", "update-checker.js", "splash.html", "splash-preload.js", "welcome.html", "welcome-preload.js", "xleth.svg", "assets/icon.ico", "assets/fonts/Barlow/*.ttf", "assets/fonts/Barlow/OFL.txt"],
  "directories": {
    "output": "../dist"
  },
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "compression": "normal",
  "extraResources": [
    {
      "from": "../bridge/build/Release",
      "to": "bridge",
      "filter": [
        "xleth_native.node",
        "*.dll",
        "xleth-editor-host.exe",
        "xleth-plugin-scanner.exe"
      ]
    },
    {
      "from": "../shm_helper/build/Release",
      "to": "shm_helper",
      "filter": ["shm_helper.node"]
    },
    {
      "from": "../media",
      "to": "media",
      "filter": ["**/*"]
    },
    {
      "from": "../art",
      "to": "art",
      "filter": ["*.png", "*.jpg", "*.jpeg", "*.webp"]
    },
    {
      "from": "../build/engine/XlethEngine_artefacts/Release",
      "to": "engine",
      "filter": ["XlethEngine.exe", "*.dll"]
    },
    {
      "from": "../vendor/ffmpeg/bin",
      "to": "ffmpeg",
      "filter": ["ffmpeg.exe", "ffprobe.exe", "*.dll"]
    },
    {
      "from": "../vendor/ffmpeg",
      "to": "ffmpeg",
      "filter": ["LICENSE", "README.txt"]
    },
    {
      "from": "../vendor/node",
      "to": "node",
      "filter": ["node.exe"]
    },
    {
      "from": "../tools/separation_sidecar",
      "to": "separation_sidecar",
      "filter": [
        "xleth_separation/**/*.py",
        "xleth_separation/models.json",
        "xleth_separation/vendor/VENDOR-NOTICE.md",
        "xleth_separation/graphs/*.onnx",
        "xleth_separation/graphs/*.onnx.json",
        "requirements.txt",
        "README.md",
        "NOTICE-separation-models.md",
        "!.venv/**/*",
        "!runtime/**/*",
        "!.runtime-cache/**/*",
        "!tests/**/*",
        "!tools/**/*",
        "!**/__pycache__/**/*"
      ]
    },
    {
      "from": "../tools/separation_sidecar/runtime",
      "to": "separation_sidecar/runtime",
      "filter": ["**/*"]
    },
    {
      "from": "addon-worker.js",
      "to": "worker/addon-worker.js"
    },
    {
      "from": "worker-dispatch-priority.js",
      "to": "worker/worker-dispatch-priority.js"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "Xleth-${version}-portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "Xleth-${version}-setup.${ext}"
  }
}
